{
  "name": "rubika-bot",
  "version": "1.0.0",
  "description": "A professional multi-purpose Rubika bot on Cloudflare Workers + D1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute rubika-bot-db --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute rubika-bot-db --remote --file=./migrations/0001_init.sql",
    "tail": "wrangler tail",
    "test": "node tests/run.js"
  },
  "devDependencies": {
    "wrangler": "^3.78.0"
  }
}
